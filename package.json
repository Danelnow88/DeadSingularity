{
  "name": "neon-void",
  "version": "0.10.0-alpha",
  "private": true,
  "description": "Roguelite arcade offline de expediciones y supervivencia",
  "productName": "NEON VOID",
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "test": "node tests/run_all.js",
    "start": "node tools/serve.js",
    "runtime:install": "node node_modules/electron/install.js",
    "desktop": "electron .",
    "build:web": "node tools/build_release.cjs",
    "build:windows": "node tools/build_release.cjs --windows",
    "verify:browser": "node --experimental-websocket tools/verify_alpha.cjs",
    "measure:weapons": "node --experimental-websocket tools/measure_weapon_pairs.cjs",
    "capture:bosses": "node --experimental-websocket tools/capture_boss_gallery.cjs",
    "measure:bosses": "node --experimental-websocket tools/measure_boss_roster.cjs",
    "capture:sectors": "node --experimental-websocket tools/capture_sector_gallery.cjs",
    "measure:performance": "node tools/performance/stress_harness.js --frames 600 --json previews/release-j/performance-stress.json"
  },
  "devDependencies": {
    "electron": "44.5.0"
  }
}
